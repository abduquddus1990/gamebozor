# @BotFather bergan token (HECH KIMGA KO'RSATMANG, GitHub'ga yuklamang!)
BOT_TOKEN=
BOT_USERNAME=akkbozorbot
CHANNEL=@eakkbozor
ADMIN_IDS=768121418,8987694079
# To'lov/yordam uchun admin username (/paysupport da ko'rinadi)
SUPPORT=@admin_username

# Test: SQLite fayl. Prod (PostgreSQL): postgresql+asyncpg://user:pass@host:5432/gamebozor
DATABASE_URL=sqlite+aiosqlite:///gamebozor.db

FREE_LISTING_LIMIT=3
TOP_3D_STARS=50
TOP_7D_STARS=100
MAX_ALERTS=5
# Kanal uchun avtomatik banner rasmi (1 — yoqiq, 0 — o'chiq)
CHANNEL_BANNER=1

# Mini App (vitrina) — ixtiyoriy:
#   WEBAPP_URL=          — vitrina o'chiq
#   WEBAPP_URL=auto      — bot o'zi Cloudflare tekin tunnelini ochadi (cloudflared o'rnatilgan bo'lishi kerak)
#   WEBAPP_URL=https://… — o'zingizning doimiy HTTPS manzilingiz
WEBAPP_URL=
# cloudflared dasturi PATH da bo'lmasa — to'liq yo'li (masalan: C:\cloudflared\cloudflared.exe)
CLOUDFLARED_PATH=
WEB_HOST=0.0.0.0
WEB_PORT=8080

# 💎 PRO sotuvchi tarifi (Telegram Stars)
PRO_30D_STARS=250
PRO_90D_STARS=600
PRO_LISTING_LIMIT=20
PRO_BUMP_HOURS=48
